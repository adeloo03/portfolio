# Required — GitHub personal access token with 'gist' scope only.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourTokenHere

# Required — the ID of your status gist (the long hex string in its URL).
# Create an empty public gist at https://gist.github.com first.
GITHUB_GIST_ID=abc123yourGistIdHere

# Optional — ISO date of the last known incident. Set to empty string to publish null.
# Example: LAST_INCIDENT=2025-03-14
LAST_INCIDENT=

# Optional — ISO date of the last time you tested a full restore. Set to empty string to publish null.
# Example: LAST_RESTORE_TEST=2025-02-01
LAST_RESTORE_TEST=
